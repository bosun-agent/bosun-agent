# BOSUN 실행 설정 — 이 파일 하나만 채우면 된다.
#
#   1) cp bosun.env.example bosun.env
#   2) 아래 값 채우기
#   3) ./scripts/bootstrap.sh  (없는 프로그램 설치)
#      ./scripts/setup.sh      (실행 파일 3종 생성 + 검사)
#      ./scripts/up.sh         (Portainer → 백엔드 → 화면)
#
# bosun.env는 커밋되지 않는다(.gitignore의 *.env). 키가 들어 있으니 공유하지 않는다.

# ── 필수 ──────────────────────────────────────────────
# OpenRouter API 키 (https://openrouter.ai/keys). 모델 호출에 쓴다.
OPENROUTER_API_KEY=

# Portainer API 키: Portainer 화면 > My account > Access tokens 에서 발급 (ptr_...)
PORTAINER_API_KEY=

# ── 선택 (기본값이 있으니 비워두면 된다) ───────────────
# 실행 폴더. agent.env·agent.yaml·session.db가 여기 생긴다. 절대경로, 공백 없이.
BOSUN_HOME=$HOME/bosun

# docker-agent 실행 파일. 비워두면 PATH의 docker-agent를 쓴다.
AGENT_BIN=$HOME/bin/docker-agent

# Portainer 주소. 직접 띄운 Portainer면 그대로 둔다.
PORTAINER_URL=https://localhost:9443

# 모델: agent.yaml에 정의된 이름(flash) 또는 provider/model 형식.
#   flash                              → 권장 (max_tokens 등 설정을 agent.yaml에서 가져간다)
#   openrouter/deepseek/deepseek-v4.1-flash
# 주의: deepseek/deepseek-v4.1-flash 처럼 provider 접두어 없이 쓰면 실행 시 500이 난다.
AGENT_MODELS=flash

# Agent 종류: beginner(계획을 먼저 보여줌) | expert(바로 승인 카드) | agent(기준 설정)
AGENT_NAME=beginner

# 화면(Vite) 포트. 백엔드는 3001 고정이다(vite.config.ts의 프록시가 3001로 박혀 있음).
WEB_PORT=5173
