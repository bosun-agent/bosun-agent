# BOSUN 컨테이너 설치 값. cp container/.env.example container/.env 후 채운다(커밋하지 않는다).

# ── 모델 ────────────────────────────────────────────────────────────────
# OpenRouter 키. 화면 설정에서 바꿔도 되지만(그때는 컨테이너 안 agent.env에 저장된다) 처음부터 넣는 편이 낫다.
OPENROUTER_API_KEY=

# ── Portainer ──────────────────────────────────────────────────────────
# 최초 1회 자동 설정(container/portainer-bootstrap.sh)에 쓰는 관리자 계정.
# 이미 Portainer를 쓰고 있고 그 계정이 있다면 그 값을 넣는다.
PORTAINER_ADMIN_USER=admin
PORTAINER_ADMIN_PASSWORD=

# 이미 Portainer에서 만든 API 키가 있으면 여기에 넣는다(My account → Access tokens).
# 넣으면 portainer-bootstrap 을 돌릴 필요가 없다.
PORTAINER_API_KEY=

# ── WEB ↔ Agent ────────────────────────────────────────────────────────
# 루프백에서만 오가는 공유 토큰. 비우면 컨테이너가 시작할 때 임의 값을 만들어 함께 쓴다
# (재시작마다 바뀌어도 무방하다. 고정하고 싶으면 값을 넣는다).
AGENT_TOKEN=

# 화면 설정에서 고를 모델 목록(쉼표로 여러 개). 비우면 agent.yaml에 적힌 모델을 그대로 쓴다.
AGENT_MODELS=openrouter/deepseek/deepseek-v4.1-flash

# ── 선택 ───────────────────────────────────────────────────────────────
# Agent·훅이 쓰는 Portainer 주소. 기본값은 스택 내부 HTTPS(https://portainer:9443)이고,
# 9000(HTTP)은 이 버전에서 API를 처리하지 않고 303으로 HTTPS로 넘긴다(11-12 확인).
# 기존 Portainer를 쓰거나 주소가 다르면 여기서 덮어쓴다.
#PORTAINER_URL_INTERNAL=https://portainer:9443

# 백업 아카이브 보관 기간(일). 게이트(soteria)를 쓸 때만 의미가 있다.
BACKUP_MAX_RETENTION_DAYS=
