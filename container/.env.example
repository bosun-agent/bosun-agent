# BOSUN 컨테이너 설치 값. cp container/.env.example container/.env 후 채운다(커밋하지 않는다).

# ── 모델 ────────────────────────────────────────────────────────────────
# OpenRouter 키. 화면 설정에서 바꿔도 되지만(그때는 컨테이너 안 agent.env에 저장된다) 처음부터 넣는 편이 낫다.
OPENROUTER_API_KEY=

# ── Portainer ──────────────────────────────────────────────────────────
# Portainer는 이 스택에 넣지 않는다(사용자가 따로 설치한다). 주소와 API 키는 두 곳 중 하나로 넣는다.
#   1) 화면: 첫 접속 설정 페이지 (권장 — 저장 전에 실제로 확인한다)
#   2) 이 파일: 아래 PORTAINER_API_KEY 에 키를 넣고 `docker compose up -d`
#      (Portainer 화면 → My account → Access tokens 에서 키를 만든다)
# Portainer 주소 두 개. Agent와 화면이 서로 다른 주소를 볼 수 있다.
PORTAINER_URL=https://10.0.11.177:9443            # 예시 — 자기 Portainer 주소로 바꾼다(브라우저가 여는 주소)
PORTAINER_URL_INTERNAL=https://10.0.11.177:9443   # 예시 — Agent·정책 훅이 붙는 주소(컨테이너 안에서 보이는 주소)

PORTAINER_API_KEY=
# (Portainer에서 만든 키: My account → Access tokens. 설정 페이지에서 넣어도 되고,
#  여기 넣으면 화면에 "이미 설정됨"으로 뜬다.)

# ── WEB ↔ Agent ────────────────────────────────────────────────────────
# 루프백에서만 오가는 공유 토큰. 비우면 컨테이너가 시작할 때 임의 값을 만들어 함께 쓴다
# (재시작마다 바뀌어도 무방하다. 고정하고 싶으면 값을 넣는다).
AGENT_TOKEN=

# 화면 설정에서 고를 모델 목록(쉼표로 여러 개). 비우면 agent.yaml에 적힌 모델을 그대로 쓴다.
AGENT_MODELS=openrouter/deepseek/deepseek-v4.1-flash

# ── 선택 ───────────────────────────────────────────────────────────────
# 백업 아카이브 보관 기간(일). 게이트(soteria)를 쓸 때만 의미가 있다.
BACKUP_MAX_RETENTION_DAYS=
