{
  "name": "bosun-web",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "server": "node --env-file=server/dev/dev.env --watch server/main.ts",
    "start": "vite build --mode http --logLevel warn && node --env-file=server/start.env --env-file=server/real.env server/main.ts",
    "agent": "node --env-file=server/real.env server/runAgent.ts",
    "server:fake": "node --env-file=server/dev/dev.env server/dev/fakeUpstream.ts",
    "server:smoke": "node --env-file=server/dev/dev.env server/dev/smoke.ts",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode http",
    "lint": "oxlint",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "test:ui": "node server/dev/uiSmoke.ts",
    "test:agent": "node server/dev/agentSmoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.48.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.6"
  }
}
