# 개발용 값. 가짜 Agent·Airlock(npm run server:fake)과 WEB 백엔드가 같이 읽는다.
# 실제 연동 때는 이 파일 대신 Secure·Agent 담당에게 받은 값을 넣은 별도 env 파일을 쓴다(커밋하지 않는다).
PORT=3001
AGENT_URL=http://127.0.0.1:8080
AGENT_NAME=agent
AGENT_MODELS=openrouter/deepseek/deepseek-v4.1-flash,openrouter/deepseek/deepseek-v4.1
AIRLOCK_MGMT_URL=http://127.0.0.1:4113
AIRLOCK_MGMT_SECRET=dev-secret
AIRLOCK_AGENT_ID=bosun-agent
WEBHOOK_TOKEN=dev-webhook
