# 개발용 값. 가짜 Agent(npm run server:fake)와 WEB 백엔드가 같이 읽는다.
# 실제 연동 때는 이 파일 대신 Agent 담당에게 받은 값을 넣은 별도 env 파일을 쓴다(커밋하지 않는다).
PORT=3001
AGENT_URL=http://127.0.0.1:8080
AGENT_NAME=agent
AGENT_MODELS=openrouter/deepseek/deepseek-v4.1-flash
# 설정 화면 API 키 저장 위치. 실제로는 Docker Agent `--env-from-file`에 넘기는 파일 경로다(계약 7장 ①).
AGENT_ENV_FILE=server/data/agent.env
# 개발용 로그인: admin / bosun-dev-password. 저장소에 올라가는 값이라 실제 env에는 쓰지 않는다(npm run set-password -- <env 파일>).
# 로컬은 HTTP라 Secure 쿠키를 끈다.
COOKIE_SECURE=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$ER0mJQePsThhDmSjQVR5Yw==$U6N/zvyjxLdvLBlRZNDR78qLdCaTdTfWlR+Cj6fpnSI=
JWT_SECRET=f5431d1dbf2ac35b911bb9fbdeaff335e047b1700cfa03c5b0cb7e3b1fc0a9d4
