# 개발용 값. 가짜 Agent(npm run server:fake)와 WEB 백엔드가 같이 읽는다.
# 실제 연동 때는 이 파일 대신 Agent 담당에게 받은 값을 넣은 별도 env 파일을 쓴다(커밋하지 않는다).
PORT=3001
AGENT_URL=http://127.0.0.1:8080
AGENT_NAME=agent
AGENT_MODELS=openrouter/deepseek/deepseek-v4.1-flash
# 설정 화면 API 키 저장 위치. 실제로는 Docker Agent `--env-from-file`에 넘기는 파일 경로다(계약 7장 ①).
AGENT_ENV_FILE=server/data/agent.env
# 정책 차단 안내의 "Portainer 열기" 링크(브라우저에서 여는 주소).
PORTAINER_URL=https://localhost:9443
