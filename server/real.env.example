# 진짜 Agent로 띄울 때 쓰는 값. 이 파일을 server/real.env로 복사해서 채운다(real.env는 커밋되지 않는다).
# 경로는 절대경로로, Windows도 / 로 쓴다(예: C:/bosun/agent/agent.env).

# docker-agent 실행 파일(v1.148.0 이상). 있으면 npm start가 Agent를 같이 띄우고 관리한다
AGENT_BIN=C:/절대경로/docker-agent.exe
# Agent의 API 키·Portainer 키 파일. session.db도 이 폴더에 생긴다
AGENT_ENV_FILE=C:/절대경로/agent-run/agent.env
# 초보자용·숙련자용 설정(beginner.yaml, expert.yaml)이 든 폴더
AGENT_CONFIG=C:/절대경로/agent-run/agents
# 처음에 쓸 Agent. beginner나 expert면 설정 > 정책에서 고를 수 있다
AGENT_NAME=beginner
AGENT_URL=http://127.0.0.1:8080
# 아무 긴 값. Agent와 WEB 백엔드가 같이 쓴다. node -e "console.log(crypto.randomUUID())"
AGENT_TOKEN=
# 설정 화면에서 고를 모델(쉼표로 여러 개). 설정에 정의된 이름을 쓴다. 직접 모델 이름을 쓰면 max_tokens 설정이 빠진다
AGENT_MODELS=flash
# docker-agent 사용 통계를 끈다(켜 두면 명령 인자·오류 문구가 Docker 서버로 간다)
TELEMETRY_ENABLED=false

# (선택) 정책에 막혔을 때 보여줄 "Portainer 열기" 링크. 브라우저에서 여는 주소
PORTAINER_URL=https://localhost:9443
